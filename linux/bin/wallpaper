#!/bin/bash
# Wallpaper Manager — fetch, set, and manage wallpapers
# Usage: wallpaper fetch          # Daily wallpaper from Unsplash
#        wallpaper random         # Random wallpaper from Unsplash
#        wallpaper pexels         # Special forces wallpaper from Pexels

set -euo pipefail

WALLPAPER_DIR="$HOME/.wallpapers"
LOG_FILE="$HOME/.helpers/wallpaper-log.txt"

mkdir -p "$WALLPAPER_DIR"

# ─── Daily Unsplash (with dedup) ──────────────────────────────
fetch() {
  local TODAYS_DATE
  TODAYS_DATE=$(date +%d-%m-%y)

  if [[ -f "$LOG_FILE" ]] && grep -q "$TODAYS_DATE" "$LOG_FILE"; then
    echo "Wallpaper already downloaded today."
    feh --recursive --bg-fill --randomize "$WALLPAPER_DIR" &
    exit 0
  fi

  echo "Downloading daily wallpaper..."
  curl -sLo "$WALLPAPER_DIR/$TODAYS_DATE-wallpaper.jpg" \
    "https://source.unsplash.com/random/1920x1080"
  touch "$LOG_FILE"
  echo "$TODAYS_DATE" >> "$LOG_FILE"

  # Cleanup: keep only the 10 most recent
  local num_images
  num_images=$(find "$WALLPAPER_DIR" -type f \( -iname '*.jpg' -o -iname '*.png' \) | wc -l)
  if (( num_images > 10 )); then
    local num_to_remove=$((num_images - 10))
    find "$WALLPAPER_DIR" -type f \( -iname '*.jpg' -o -iname '*.png' \) \
      | sort | head -n "$num_to_remove" | xargs -I {} rm "{}"
  fi

  feh --recursive --bg-fill --randomize "$WALLPAPER_DIR" &
}

# ─── Random Unsplash (on-demand) ──────────────────────────────
random() {
  echo "Fetching random wallpaper from Unsplash..."
  curl -sL "https://source.unsplash.com/collection/1053828/1366x768" \
    | feh --bg-fill -
}

# ─── Pexels Special Forces ────────────────────────────────────
pexels() {
  local IMAGE_PATH="$WALLPAPER_DIR/pexels-default.jpg"

  # Load .env for PEXELS_KEY
  if [[ -f .env ]]; then
    export $(grep -v '^#' .env | xargs)
  fi

  if [[ -z "${PEXELS_KEY:-}" ]]; then
    echo "PEXELS_KEY not set in .env file"
    exit 1
  fi

  local IMAGE_URL
  IMAGE_URL=$(curl -s \
    "https://api.pexels.com/v1/search?query=army+with+weapon+special+forces&per_page=1&page=$((RANDOM % 100 + 1))" \
    -H "Authorization: $PEXELS_KEY" | jq -r '.photos[0].src.original')

  if [[ -z "$IMAGE_URL" || "$IMAGE_URL" == "null" ]]; then
    echo "Failed to fetch Pexels image"
    exit 1
  fi

  curl -s -o "$IMAGE_PATH" "$IMAGE_URL"
  feh --bg-fill "$IMAGE_PATH"
  echo "Pexels wallpaper set!"
}

# ─── Main ─────────────────────────────────────────────────────
case "${1:-}" in
  fetch)  fetch ;;
  random) random ;;
  pexels) pexels ;;
  *)
    echo "Wallpaper Manager — fetch, random, or pexels wallpapers"
    echo ""
    echo "Usage:"
    echo "  wallpaper fetch      # Daily Unsplash wallpaper"
    echo "  wallpaper random     # Random Unsplash"
    echo "  wallpaper pexels     # Special Forces from Pexels (requires .env)"
    exit 1
    ;;
esac
