#!/bin/bash
# Web Launcher — open websites in Chrome via rofi/dmenu
# Usage: web-launcher

set -euo pipefail

declare -A websites=(
  ["ChatGPT"]="https://chat.openai.com"
  ["Claude"]="https://claude.ai"
  ["TheB.ai"]="https://theb.ai.com"
  ["Notion"]="https://www.notion.so"
  ["Google Calendar"]="https://calendar.google.com"
  ["WhatsApp Web"]="https://web.whatsapp.com"
  ["Google Keep"]="https://keep.google.com"
  ["LinkedIn"]="https://www.linkedin.com"
  ["Google Drive"]="https://drive.google.com"
  ["Gmail"]="https://mail.google.com"
  ["YouTube"]="https://www.youtube.com"
  ["GeeksForGeeks"]="https://www.geeksforgeeks.org"
  ["Striver's SDE Sheet"]="https://takeuforward.org/interviews/strivers-sde-sheet-top-150-most-important-questions/"
)

if command -v rofi &>/dev/null; then
  chosen=$(printf '%s\n' "${!websites[@]}" | rofi -dmenu -i -p "Open Website:")
elif command -v dmenu &>/dev/null; then
  chosen=$(printf '%s\n' "${!websites[@]}" | dmenu -i -p "Open Website:")
else
  echo "Select website:"
  select chosen in "${!websites[@]}"; do break; done
fi

if [[ -n "$chosen" && -n "${websites[$chosen]:-}" ]]; then
  google-chrome-stable "${websites[$chosen]}"
fi
