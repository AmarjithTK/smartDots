#!/bin/bash
# Display Manager — brightness (brightnessctl + ddcutil) & color temperature
# Auto-detects: laptop backlight → brightnessctl | desktop DDC/CI → ddcutil
# Persistence: saves/restores brightness across reboots
# GUI: kdialog slider for KDE Plasma panel integration
# Usage: display-manager brightness [inc|dec|set N|get|save|restore|gui]
#        display-manager colortemp [inc|dec]
#        display-manager status

set -euo pipefail

STATE_FILE="$HOME/.helpers/brightness-state.txt"

# ─── Auto-detect brightness method ───────────────────────────────
detect_method() {
  # 1. Laptop backlight (brightnessctl)
  if command -v brightnessctl &>/dev/null && brightnessctl -l 2>/dev/null | grep -q .; then
    echo "brightnessctl"
    return
  fi

  # 2. Desktop DDC/CI monitor (ddcutil)
  if command -v ddcutil &>/dev/null; then
    if ddcutil detect 2>/dev/null | grep -q "Monitor"; then
      echo "ddcutil"
      return
    fi
    # ddcutil installed but no monitor detected
    echo "ddcutil-no-monitor"
    return
  fi

  # 3. No method available
  echo "none"
}

# ─── Brightness via brightnessctl (laptop) ─────────────────────
brightness_brightnessctl() {
  local action="${1:-inc}"
  local delta="${2:-5}"

  case "$action" in
    inc|increase) brightnessctl set "+${delta}%" ;;
    dec|decrease) brightnessctl set "${delta}%-" ;;
    set)
      brightnessctl set "${delta}%"
      ;;
    get)
      brightnessctl -m | head -1 | awk -F',' '{print $4}' | tr -d '%'
      ;;
    save)
      local val
      val=$(brightnessctl -m | head -1 | awk -F',' '{print $4}' | tr -d '%')
      echo "brightnessctl $val" > "$STATE_FILE"
      echo "Saved: brightnessctl $val%"
      ;;
    restore)
      if [[ -f "$STATE_FILE" ]]; then
        local saved
        saved=$(grep "^brightnessctl" "$STATE_FILE" | awk '{print $2}')
        if [[ -n "$saved" ]]; then
          brightnessctl set "${saved}%"
          echo "Restored: brightnessctl ${saved}%"
        fi
      fi
      ;;
    gui)
      local current
      current=$(brightnessctl -m | head -1 | awk -F',' '{print $4}' | tr -d '%')
      if command -v kdialog &>/dev/null; then
        local new
        new=$(kdialog --slider "Brightness" 0 100 "$current")
        [[ -n "$new" ]] && brightnessctl set "${new}%"
      elif command -v zenity &>/dev/null; then
        local new
        new=$(zenity --scale --text="Brightness" --value="$current" --min=0 --max=100)
        [[ -n "$new" ]] && brightnessctl set "${new}%"
      else
        read -p "Brightness % (0-100): " new
        brightnessctl set "${new}%"
      fi
      brightness_brightnessctl save
      ;;
    *)
      echo "Usage: display-manager brightness [inc|dec|set N|get|save|restore|gui]"
      exit 1
      ;;
  esac
}

# ─── Brightness via ddcutil (desktop monitor) ───────────────────
brightness_ddcutil() {
  local action="${1:-inc}"
  local delta="${2:-5}"
  local monitors

  # Get all DDC-capable monitors
  monitors=$(ddcutil detect 2>/dev/null | grep -B1 "MCCS version" | grep "Display" | awk -F: '{print $1}' | tr -d ' ')

  if [[ -z "$monitors" ]]; then
    echo "No DDC/CI monitors detected"
    exit 1
  fi

  for display in $monitors; do
    local current max new
    IFS=' ' read -r current max <<< "$(ddcutil --display "$display" getvcp 10 -t 2>/dev/null | awk '{print $4, $5}')"

    [[ -z "$current" || -z "$max" ]] && continue

    case "$action" in
      inc|increase)
        new=$((current + (max * delta / 100)))
        (( new > max )) && new=$max
        ddcutil --display "$display" setvcp 10 "$new"
        echo "Display $display: $((new * 100 / max))%"
        ;;
      dec|decrease)
        new=$((current - (max * delta / 100)))
        (( new < 0 )) && new=0
        ddcutil --display "$display" setvcp 10 "$new"
        echo "Display $display: $((new * 100 / max))%"
        ;;
      set)
        new=$((max * delta / 100))
        (( new < 0 )) && new=0
        (( new > max )) && new=$max
        ddcutil --display "$display" setvcp 10 "$new"
        echo "Display $display: ${delta}%"
        ;;
      get)
        echo "$((current * 100 / max))"
        ;;
      save)
        local pct=$((current * 100 / max))
        echo "ddcutil $pct" > "$STATE_FILE"
        echo "Saved: ddcutil ${pct}%"
        ;;
      restore)
        if [[ -f "$STATE_FILE" ]]; then
          local saved
          saved=$(grep "^ddcutil" "$STATE_FILE" | awk '{print $2}')
          if [[ -n "$saved" ]]; then
            new=$((max * saved / 100))
            ddcutil --display "$display" setvcp 10 "$new"
            echo "Display $display restored: ${saved}%"
          fi
        fi
        ;;
      gui)
        local pct=$((current * 100 / max))
        if command -v kdialog &>/dev/null; then
          local new_pct
          new_pct=$(kdialog --slider "Display $display Brightness" 0 100 "$pct")
          [[ -n "$new_pct" ]] && ddcutil --display "$display" setvcp 10 "$((max * new_pct / 100))"
        elif command -v zenity &>/dev/null; then
          local new_pct
          new_pct=$(zenity --scale --text="Display $display Brightness" --value="$pct" --min=0 --max=100)
          [[ -n "$new_pct" ]] && ddcutil --display "$display" setvcp 10 "$((max * new_pct / 100))"
        else
          read -p "Brightness % (0-100): " new_pct
          ddcutil --display "$display" setvcp 10 "$((max * new_pct / 100))"
        fi
        brightness_ddcutil save
        ;;
      *)
        echo "Usage: display-manager brightness [inc|dec|set N|get|save|restore|gui]"
        exit 1
        ;;
    esac
  done
}

# ─── Brightness (auto-dispatch) ─────────────────────────────────
brightness() {
  local method
  method=$(detect_method)

  case "$method" in
    brightnessctl)
      brightness_brightnessctl "$@"
      ;;
    ddcutil)
      brightness_ddcutil "$@"
      ;;
    ddcutil-no-monitor)
      echo "ddcutil installed but no DDC/CI monitor detected."
      echo "Check connections and try: sudo modprobe i2c-dev"
      exit 1
      ;;
    none)
      echo "No brightness control method detected."
      echo ""
      echo "Available methods:"
      echo "  brightnessctl — for laptop backlights (sudo pacman -S brightnessctl)"
      echo "  ddcutil      — for desktop monitors with DDC/CI (sudo pacman -S ddcutil)"
      echo ""
      echo "To set up DDC/CI:"
      echo "  sudo pacman -S ddcutil"
      echo "  sudo modprobe i2c-dev"
      echo "  sudo usermod -aG i2c \$USER"
      echo "  # Log out and back in"
      exit 1
      ;;
  esac
}

# ─── Color Temperature ──────────────────────────────────────────
colortemp() {
  command -v redshift &>/dev/null || {
    echo "redshift not installed. Install: sudo pacman -S redshift"
    exit 1
  }

  local temp_file="$HOME/.helpers/colortemp.txt"
  local default_temp=4000
  local increment=300
  local current_temp

  if [[ -f "$temp_file" ]]; then
    current_temp=$(cat "$temp_file")
  else
    current_temp=$default_temp
  fi

  if [[ "${1:-}" == "dec" || "${1:-}" == "decrease" ]]; then
    increment=-$increment
  fi

  local new_temp=$((current_temp + increment))
  (( new_temp < 1000 )) && new_temp=1000
  (( new_temp > 10000 )) && new_temp=10000

  redshift -P -O "$new_temp"
  echo "$new_temp" > "$temp_file"
}

# ─── Status ─────────────────────────────────────────────────────
status() {
  local method
  method=$(detect_method)
  echo "Display Manager Status"
  echo "======================"
  echo "Brightness method: $method"

  case "$method" in
    brightnessctl)
      echo ""
      echo "Backlight devices:"
      brightnessctl -l 2>/dev/null
      echo ""
      echo "Current: $(brightnessctl -m | head -1 | awk -F',' '{print $4}')"
      ;;
    ddcutil)
      echo ""
      echo "DDC/CI Monitors:"
      ddcutil detect 2>/dev/null
      ;;
    none)
      echo ""
      echo "No brightness control available."
      ;;
  esac

  if [[ -f "$STATE_FILE" ]]; then
    echo ""
    echo "Saved state: $(cat "$STATE_FILE")"
  else
    echo ""
    echo "No saved brightness state."
  fi
}

# ─── Main ───────────────────────────────────────────────────────
case "${1:-}" in
  brightness)
    shift
    brightness "$@"
    ;;
  colortemp)
    colortemp "${2:-}"
    ;;
  status)
    status
    ;;
  *)
    echo "Display Manager — brightness & color temperature control"
    echo ""
    echo "Usage:"
    echo "  display-manager brightness [inc|dec|set N|get|save|restore|gui]"
    echo "  display-manager colortemp [inc|dec]"
    echo "  display-manager status"
    echo ""
    echo "Examples:"
    echo "  display-manager brightness inc       # Increase by 5%"
    echo "  display-manager brightness dec       # Decrease by 5%"
    echo "  display-manager brightness set 50    # Set to 50%"
    echo "  display-manager brightness gui       # GUI slider"
    echo "  display-manager brightness save      # Save current"
    echo "  display-manager brightness restore   # Restore saved"
    echo "  display-manager brightness get       # Get current %"
    echo "  display-manager status               # Show detection info"
    exit 1
    ;;
esac
